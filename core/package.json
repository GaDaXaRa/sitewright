{
  "name": "@sitewright/core",
  "version": "0.1.0",
  "description": "The invariant half of a Sitewright site: pure logic, image handling, form brakes and SEO plumbing.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./payload": {
      "types": "./dist/payload/index.d.ts",
      "import": "./dist/payload/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "import": "./dist/audit/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutacion": "stryker run"
  },
  "devDependencies": {
    "@payloadcms/ui": "^3.88.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.19.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.0",
    "payload": "^3.88.0",
    "pg": "^8.23.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@payloadcms/ui": ">=3.88",
    "@vercel/blob": ">=2",
    "next": ">=16",
    "payload": ">=3.88",
    "pg": ">=8",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@payloadcms/ui": {
      "optional": true
    },
    "@vercel/blob": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "bin": {
    "sitewright-audit": "./dist/audit/cli.js"
  }
}
