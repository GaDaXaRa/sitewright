{
  "name": "@sitewright/core",
  "version": "0.1.0",
  "description": "The invariant half of a Sitewright site: pure logic, image handling, form brakes and SEO plumbing.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutacion": "stryker run"
  },
  "devDependencies": {
    "@types/node": "^22.19.9",
    "typescript": "5.7.3",
    "vitest": "4.1.10"
  }
}
