# Postgres (Neon in dev and prod). In dev, a free Neon branch.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the site (metadata, canonical, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.ejemplo.es

# Image storage in production (Vercel Blob). With no token, uploads go to local disk.
BLOB_READ_WRITE_TOKEN=

# Email (Resend) — optional in development.
# With no RESEND_API_KEY, emails are written to the console instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Nombre del sitio
# Where booking notifications go (falls back to the email in "Ajustes del sitio").
EMAIL_NOTIFY=
